{
  "manifest_version": 3,
  "name": "Crypto & Stock Tracker",
  "version": "1.1.0",
  "description": "Theo dõi giá tiền điện tử (Cryptocurrency) và Cổ phiếu Việt Nam/Quốc tế thời gian thực.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
